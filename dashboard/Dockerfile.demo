FROM node:18-alpine AS assets
WORKDIR /build
COPY openmct-tutorial/package.json openmct-tutorial/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir websockets==17.2
COPY --from=assets /build/node_modules/openmct/dist /app/openmct-tutorial/node_modules/openmct/dist
COPY dashboard/index.html dashboard/*.js dashboard/dataTest.py /app/dashboard/
COPY index.html /app/index.html
ENV PYTHONUNBUFFERED=1
CMD ["python", "dashboard/dataTest.py", "--json-dir", "/telemetry", "--host", "0.0.0.0"]
